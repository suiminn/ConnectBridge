+    #[test]
+    fn change_during_the_settle_window_is_found_when_it_ends() {
+        let mut l = logic();
+        let reads = Cell::new(0);
+        synced_at(&mut l, &reads, 0.4);
+        // the route volume changes inside the window; the notification only finds the window open
+        assert_eq!(poll(&mut l, SETTLE + 300, true, 0.8, &reads), None);
+        assert!(!l.needs_poll(SETTLE + 400));
+        assert!(l.needs_poll(2 * SETTLE), "due at the end of the window, no new notification needed");
+        let (volume, _) = poll(&mut l, 2 * SETTLE, true, 0.8, &reads).expect("sent when the window is over");
+        assert_eq!(volume, (0.8f32 * u16::MAX as f32).round() as u16);
+    }
+
+    #[test]
+    fn connect_volume_opens_a_settle_window_that_ends_with_a_look() {
+        let mut l = logic();
+        let reads = Cell::new(0);
+        synced_at(&mut l, &reads, 0.4);
+        assert_eq!(poll(&mut l, 2 * SETTLE, true, 0.4, &reads), None);
+        assert!(!l.needs_poll(5_000));
+        l.connect_volume(30_000, 5_000, true).unwrap();
+        assert!(!l.needs_poll(5_000 + SETTLE - 1));
+        assert!(l.needs_poll(5_000 + SETTLE));
+        assert_eq!(poll(&mut l, 5_000 + SETTLE, true, 30_000.0 / 65535.0, &reads), None);
+        assert!(!l.needs_poll(5_000 + SETTLE + 1));
+    }
+
+    #[test]
+    fn failed_send_is_due_at_once_and_a_finished_send_is_looked_at_again() {
+        let mut l = logic();
+        let reads = Cell::new(0);
+        synced_at(&mut l, &reads, 0.4);
+        let (_, t) = poll(&mut l, 5_000, true, 0.7, &reads).unwrap();
+        l.sent(t, false, 5_100);
+        assert!(l.needs_poll(5_100), "the difference has to be sent again without a new notification");
+        let (_, t) = poll(&mut l, 5_100, true, 0.7, &reads).unwrap();
+        l.sent(t, true, 5_200);
+        assert!(l.needs_poll(5_200), "volume changes while the send was in progress were not looked at");
+        assert_eq!(poll(&mut l, 5_200, true, 0.7, &reads), None);
+    }
+
+    #[test]
+    fn unreadable_route_volume_is_tried_again() {
+        let mut l = logic();
+        let reads = Cell::new(0);
+        synced_at(&mut l, &reads, 0.4);
+        assert_eq!(poll(&mut l, 4_000, true, 0.4, &reads), None); // looked at: nothing due any more
+        assert_eq!(poll(&mut l, 5_000, true, -1.0, &reads), None);
+        assert!(!l.needs_poll(5_000 + RETRY_MS - 1));
+        assert!(l.needs_poll(5_000 + RETRY_MS));
+        assert!(poll(&mut l, 5_000 + RETRY_MS, true, 0.9, &reads).is_some());
+    }
+
+    #[test]
+    fn route_lost_clears_what_was_due() {
+        let mut l = logic();
+        let reads = Cell::new(0);
+        synced_at(&mut l, &reads, 0.4);
+        assert_eq!(poll(&mut l, 9_000, false, 0.4, &reads), None); // lost
+        assert!(l.needs_poll(9_000), "not synced any more: the first sync is waited for");
+    }
