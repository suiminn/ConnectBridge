+
+// --- Now Playing info and remote commands (HomePod shows / controls what the AirPlay source reports) ---
+#import <MediaPlayer/MediaPlayer.h>
+#import <UIKit/UIKit.h>
+
+typedef void (*cb_command_fn)(int command, double position_seconds);
+
+// MediaPlayer only works when its work runs on the main thread with a running run loop (a
+// dedicated thread with its own run loop is not enough). The Rust side therefore runs its
+// runtime on a second thread and hands the main thread to cb_run_main_loop().
+static NSMutableDictionary *gNowPlayingInfo;
+static NSString *gArtworkURL;
+
+@interface CBNowPlaying : NSObject
++ (void)run:(dispatch_block_t)block;
+@end
+
+@implementation CBNowPlaying
++ (void)run:(dispatch_block_t)block {
+    static dispatch_once_t once;
+    dispatch_once(&once, ^{ gNowPlayingInfo = [NSMutableDictionary dictionary]; });
+    dispatch_async(dispatch_get_main_queue(), block);
+}
+@end
+
+void cb_run_main_loop(void) {
+    [[NSRunLoop mainRunLoop] addPort:[NSMachPort port] forMode:NSDefaultRunLoopMode];
+    for (;;) {
+        @autoreleasepool {
+            [[NSRunLoop mainRunLoop] runMode:NSDefaultRunLoopMode beforeDate:[NSDate distantFuture]];
+        }
+    }
+}
+
+static void cb_publish_now_playing(void) {
+    [MPNowPlayingInfoCenter defaultCenter].nowPlayingInfo = [gNowPlayingInfo copy];
+}
+
+void cb_register_remote_commands(cb_command_fn fn) {
+    [CBNowPlaying run:^{
+        MPRemoteCommandCenter *center = [MPRemoteCommandCenter sharedCommandCenter];
+        void (^reg)(MPRemoteCommand *, int) = ^(MPRemoteCommand *command, int code) {
+            command.enabled = YES;
+            [command addTargetWithHandler:^MPRemoteCommandHandlerStatus(MPRemoteCommandEvent *event) {
+                fn(code, 0);
+                return MPRemoteCommandHandlerStatusSuccess;
+            }];
+        };
+        reg(center.playCommand, 1);
+        reg(center.pauseCommand, 2);
+        reg(center.togglePlayPauseCommand, 3);
+        reg(center.nextTrackCommand, 4);
+        reg(center.previousTrackCommand, 5);
+        center.changePlaybackPositionCommand.enabled = YES;
+        [center.changePlaybackPositionCommand addTargetWithHandler:^MPRemoteCommandHandlerStatus(MPRemoteCommandEvent *event) {
+            fn(6, ((MPChangePlaybackPositionCommandEvent *)event).positionTime);
+            return MPRemoteCommandHandlerStatusSuccess;
+        }];
+        NSLog(@"librespot: remote commands registered");
+    }];
+}
+
+void cb_now_playing_set_track(const char *title, const char *artist, const char *album, double duration, const char *artwork_url) {
+    NSString *t = @(title), *a = @(artist), *al = @(album), *url = (artwork_url && *artwork_url) ? @(artwork_url) : nil;
+    [CBNowPlaying run:^{
+        [gNowPlayingInfo removeAllObjects];
+        gNowPlayingInfo[MPMediaItemPropertyTitle] = t;
+        gNowPlayingInfo[MPMediaItemPropertyArtist] = a;
+        gNowPlayingInfo[MPMediaItemPropertyAlbumTitle] = al;
+        gNowPlayingInfo[MPMediaItemPropertyPlaybackDuration] = @(duration);
+        gNowPlayingInfo[MPNowPlayingInfoPropertyElapsedPlaybackTime] = @0;
+        gNowPlayingInfo[MPNowPlayingInfoPropertyPlaybackRate] = @0;
+        gArtworkURL = url;
+        cb_publish_now_playing();
+        NSURL *artworkURL = url ? [NSURL URLWithString:url] : nil; if (!artworkURL) return;  // a nil URL throws
+        [[[NSURLSession sharedSession] dataTaskWithURL:artworkURL completionHandler:^(NSData *data, NSURLResponse *r, NSError *e) {
+            UIImage *image = data ? [UIImage imageWithData:data] : nil;
+            if (!image) return;
+            [CBNowPlaying run:^{
+                if (![gArtworkURL isEqualToString:url]) return;  // the track changed meanwhile
+                gNowPlayingInfo[MPMediaItemPropertyArtwork] =
+                    [[MPMediaItemArtwork alloc] initWithBoundsSize:image.size requestHandler:^UIImage *(CGSize size) { return image; }];
+                cb_publish_now_playing();
+            }];
+        }] resume];
+    }];
+}
+
+// state: 0 paused, 1 playing, 2 stopped
+void cb_now_playing_set_state(int state, double position) {
+    [CBNowPlaying run:^{
+        gNowPlayingInfo[MPNowPlayingInfoPropertyElapsedPlaybackTime] = @(position);
+        gNowPlayingInfo[MPNowPlayingInfoPropertyPlaybackRate] = @(state == 1 ? 1.0 : 0.0);
+        cb_publish_now_playing();
+        [MPNowPlayingInfoCenter defaultCenter].playbackState =
+            state == 1 ? MPNowPlayingPlaybackStatePlaying : state == 0 ? MPNowPlayingPlaybackStatePaused : MPNowPlayingPlaybackStateStopped;
+    }];
+}
+
+void cb_now_playing_clear(void) {
+    [CBNowPlaying run:^{
+        [gNowPlayingInfo removeAllObjects];
+        gArtworkURL = nil;
+        [MPNowPlayingInfoCenter defaultCenter].nowPlayingInfo = nil;
+        [MPNowPlayingInfoCenter defaultCenter].playbackState = MPNowPlayingPlaybackStateStopped;
+    }];
+}
+
+// --- output route guard: is the audio about to come out of the built-in speaker? ---
+
+typedef void (*cb_route_fn)(int leaking);
+
+static int cb_route_leaks(void) {
+    for (AVAudioSessionPortDescription *port in [AVAudioSession sharedInstance].currentRoute.outputs) {
+        if ([port.portType isEqualToString:AVAudioSessionPortBuiltInSpeaker] ||
+            [port.portType isEqualToString:AVAudioSessionPortBuiltInReceiver]) return 1;
+    }
+    return 0;
+}
+
+int cb_output_leaks(void) { return cb_route_leaks(); }
+
+void cb_watch_route(cb_route_fn fn) {
+    [[NSNotificationCenter defaultCenter] addObserverForName:AVAudioSessionRouteChangeNotification object:nil queue:nil
+        usingBlock:^(NSNotification *n) {
+            fn(cb_route_leaks());
+            NSMutableArray *ports = [NSMutableArray array];
+            for (AVAudioSessionPortDescription *port in [AVAudioSession sharedInstance].currentRoute.outputs) {
+                [ports addObject:[NSString stringWithFormat:@"%@ [%@]", port.portName, port.portType]];
+            }
+            NSLog(@"librespot: output route: %@", ports.count ? [ports componentsJoinedByString:@", "] : @"(none)");
+        }];
+}
