index 0000000..35fc9bc
--- /dev/null
+++ b/src/notif_check.rs
@@ -0,0 +1,231 @@
+//! connectbridge: compares the system volume polling with the KVO of `AVAudioSession.outputVolume`,
+//! without any platform calls, so that it
+//! can be tested on a Mac (`scripts/test-daemon.sh` runs the tests below with `rustc --test`).
+//!
+//! Observation only: nothing here changes what the volume bridge does. It answers whether the
+//! notification could replace the polling: every change that the polling sees should come with a
+//! notification (`missed` otherwise), and every notification with a change (`extra` otherwise).
+//! A change and a notification belong together when they are less than `WINDOW_MS` apart; the
+//! notification may come before the poll sees the change (up to one poll interval) or after it.
+
+#![allow(dead_code)]
+
+use std::collections::VecDeque;
+
+/// How far apart a change seen by the polling and its notification may be.
+pub const WINDOW_MS: u64 = 1000;
+/// Resolved entries are kept this long, for the entries on the other side that still need them.
+const KEEP_MS: u64 = 4 * WINDOW_MS;
+/// The volume is a float that the system rounds; smaller differences are not a change.
+const TOLERANCE: f32 = 0.0005;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Verdict {
+    /// The polling saw a change at this time and no notification came.
+    Missed(u64),
+    /// A notification came at this time and the polling saw no change.
+    Extra(u64),
+}
+
+struct Entry {
+    at: u64,
+    resolved: bool,
+}
+
+#[derive(Default)]
+pub struct NotifCheck {
+    last_raw: Option<f32>,
+    changes: VecDeque<Entry>,
+    notifs: VecDeque<Entry>,
+    pub changes_seen: u64,
+    pub notifs_seen: u64,
+    pub missed: u64,
+    pub extra: u64,
+}
+
+impl NotifCheck {
+    pub const fn new() -> Self {
+        NotifCheck {
+            last_raw: None,
+            changes: VecDeque::new(),
+            notifs: VecDeque::new(),
+            changes_seen: 0,
+            notifs_seen: 0,
+            missed: 0,
+            extra: 0,
+        }
+    }
+
+    pub fn on_notification(&mut self, now_ms: u64) {
+        self.notifs_seen += 1;
+        self.notifs.push_back(Entry { at: now_ms, resolved: false });
+    }
+
+    /// One reading of the system volume (`None`: it could not be read).
+    pub fn on_sample(&mut self, now_ms: u64, raw: Option<f32>) {
+        let Some(raw) = raw.filter(|v| *v >= 0.0) else {
+            self.last_raw = None; // unreadable: the next reading is a new start, not a change
+            return;
+        };
+        if self.last_raw.is_some_and(|last| (raw - last).abs() > TOLERANCE) {
+            self.changes_seen += 1;
+            self.changes.push_back(Entry { at: now_ms, resolved: false });
+        }
+        self.last_raw = Some(raw);
+    }
+
+    /// The volume cannot be compared now (the route is not the wanted one, or has only just become
+    /// so): forget the last reading and everything not yet decided. Changes and notifications that
+    /// come with a route switch are not the notification's doing.
+    pub fn pause(&mut self) {
+        self.last_raw = None;
+        self.changes.clear();
+        self.notifs.clear();
+    }
+
+    /// Decides what is old enough to be decided; call it after every sample.
+    pub fn tick(&mut self, now_ms: u64) -> Vec<Verdict> {
+        let mut verdicts = Vec::new();
+        let near = |a: u64, b: u64| a.abs_diff(b) <= WINDOW_MS;
+        for c in self.changes.iter_mut().filter(|c| !c.resolved && now_ms >= c.at + WINDOW_MS) {
+            c.resolved = true;
+            if !self.notifs.iter().any(|n| near(n.at, c.at)) {
+                self.missed += 1;
+                verdicts.push(Verdict::Missed(c.at));
+            }
+        }
+        for n in self.notifs.iter_mut().filter(|n| !n.resolved && now_ms >= n.at + WINDOW_MS) {
+            n.resolved = true;
+            if !self.changes.iter().any(|c| near(n.at, c.at)) {
+                self.extra += 1;
+                verdicts.push(Verdict::Extra(n.at));
+            }
+        }
+        while self.changes.front().is_some_and(|c| c.resolved && now_ms >= c.at + KEEP_MS) {
+            self.changes.pop_front();
+        }
+        while self.notifs.front().is_some_and(|n| n.resolved && now_ms >= n.at + KEEP_MS) {
+            self.notifs.pop_front();
+        }
+        verdicts
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Samples the volume every 250 ms from `from` to `to`; the volume steps to `v` at `step_at`.
+    fn run(check: &mut NotifCheck, from: u64, to: u64, step_at: Option<(u64, f32)>, start: f32) -> Vec<Verdict> {
+        let mut out = Vec::new();
+        let mut t = from;
+        while t <= to {
+            let v = match step_at {
+                Some((at, v)) if t >= at => v,
+                _ => start,
+            };
+            check.on_sample(t, Some(v));
+            out.extend(check.tick(t));
+            t += 250;
+        }
+        out
+    }
+
+    #[test]
+    fn change_with_a_notification_just_before_is_covered() {
+        let mut c = NotifCheck::new();
+        c.on_notification(5_000); // the poll sees the change up to one interval later
+        let out = run(&mut c, 0, 8_000, Some((5_100, 0.4)), 0.3);
+        assert!(out.is_empty());
+        assert_eq!((c.changes_seen, c.notifs_seen, c.missed, c.extra), (1, 1, 0, 0));
+    }
+
+    #[test]
+    fn change_with_a_notification_just_after_is_covered() {
+        let mut c = NotifCheck::new();
+        let mut out = run(&mut c, 0, 5_250, Some((5_000, 0.4)), 0.3);
+        c.on_notification(5_300);
+        out.extend(run(&mut c, 5_500, 9_000, Some((5_000, 0.4)), 0.3));
+        assert!(out.is_empty());
+        assert_eq!((c.missed, c.extra), (0, 0));
+    }
+
+    #[test]
+    fn change_without_a_notification_is_missed() {
+        let mut c = NotifCheck::new();
+        let out = run(&mut c, 0, 8_000, Some((5_000, 0.4)), 0.3);
+        assert_eq!(out, vec![Verdict::Missed(5_000)]);
+        assert_eq!(c.missed, 1);
+    }
+
+    #[test]
+    fn notification_without_a_change_is_extra() {
+        let mut c = NotifCheck::new();
+        c.on_notification(5_000);
+        let out = run(&mut c, 0, 8_000, None, 0.3);
+        assert_eq!(out, vec![Verdict::Extra(5_000)]);
+        assert_eq!(c.extra, 1);
+    }
+
+    #[test]
+    fn a_notification_far_from_the_change_does_not_cover_it() {
+        let mut c = NotifCheck::new();
+        c.on_notification(1_000);
+        let out = run(&mut c, 0, 12_000, Some((6_000, 0.4)), 0.3);
+        assert!(out.contains(&Verdict::Missed(6_000)));
+        assert!(out.contains(&Verdict::Extra(1_000)));
+    }
+
+    #[test]
+    fn several_steps_and_several_notifications() {
+        let mut c = NotifCheck::new();
+        let mut t = 0;
+        let mut v = 0.3;
+        let mut out = Vec::new();
+        while t <= 20_000 {
+            if t == 4_000 || t == 4_500 || t == 9_000 {
+                v += 0.05;
+                c.on_notification(t);
+            }
+            c.on_sample(t, Some(v));
+            out.extend(c.tick(t));
+            t += 250;
+        }
+        assert!(out.is_empty());
+        assert_eq!((c.changes_seen, c.notifs_seen), (3, 3));
+    }
+
+    #[test]
+    fn small_differences_and_unreadable_samples_are_not_changes() {
+        let mut c = NotifCheck::new();
+        c.on_sample(0, Some(0.3));
+        c.on_sample(250, Some(0.3002));
+        c.on_sample(500, None);
+        c.on_sample(750, Some(0.9)); // after an unreadable reading: a start, not a change
+        c.on_sample(1_000, Some(-1.0));
+        assert_eq!(c.changes_seen, 0);
+        assert!(c.tick(10_000).is_empty());
+    }
+
+    #[test]
+    fn pause_forgets_undecided_entries_and_the_last_reading() {
+        let mut c = NotifCheck::new();
+        c.on_sample(0, Some(0.3));
+        c.on_notification(100);
+        c.pause(); // route switch: the notification and the jump of the volume mean nothing
+        c.on_sample(250, Some(0.8)); // first reading after the pause is a start, not a change
+        assert!(c.tick(10_000).is_empty());
+        assert_eq!((c.missed, c.extra), (0, 0));
+    }
+
+    #[test]
+    fn resolved_entries_are_dropped_after_a_while() {
+        let mut c = NotifCheck::new();
+        c.on_notification(0);
+        c.on_sample(0, Some(0.3));
+        c.on_sample(250, Some(0.4));
+        c.tick(2_000);
+        c.tick(20_000);
+        assert!(c.changes.is_empty() && c.notifs.is_empty());
+    }
+}
diff --git a/src/now_playing.rs b/src/now_playing.rs
new file mode 100644
index 0000000..fd7eea6
--- /dev/null
+++ b/src/now_playing.rs
@@ -0,0 +1,168 @@
+//! connectbridge: reports what is playing to the system (Now Playing) so that the AirPlay
+//! receiver (HomePod) can show it, and turns its remote commands into Spirc commands.
+
+use librespot::playback::player::PlayerEvent;
+
+#[derive(Clone, Copy, Debug)]
+pub enum RemoteCommand {
+    Play,
+    Pause,
+    TogglePlayPause,
+    Next,
+    Previous,
+    SeekMs(u32),
+}
+
+#[cfg(target_os = "ios")]
+mod imp {
+    use super::*;
+    use librespot::metadata::audio::UniqueFields;
+    use std::{
+        collections::VecDeque,
+        ffi::CString,
+        os::raw::{c_char, c_double, c_int},
+        sync::Mutex,
+    };
+
+    unsafe extern "C" {
+        fn cb_register_remote_commands(callback: extern "C" fn(c_int, c_double));
+        fn cb_now_playing_set_track(
+            title: *const c_char,
+            artist: *const c_char,
+            album: *const c_char,
+            duration: c_double,
+            artwork_url: *const c_char,
+        );
+        fn cb_now_playing_set_state(state: c_int, position: c_double);
+        fn cb_now_playing_clear();
+    }
+
+    static COMMANDS: Mutex<VecDeque<RemoteCommand>> = Mutex::new(VecDeque::new());
+    static PLAYING: Mutex<bool> = Mutex::new(false);
+
+    pub fn enabled() -> bool {
+        std::env::var_os("CB_NOW_PLAYING").is_some()
+    }
+
+    extern "C" fn on_command(code: c_int, position: c_double) {
+        let command = match code {
+            1 => RemoteCommand::Play,
+            2 => RemoteCommand::Pause,
+            3 => RemoteCommand::TogglePlayPause,
+            4 => RemoteCommand::Next,
+            5 => RemoteCommand::Previous,
+            6 => RemoteCommand::SeekMs((position.max(0.0) * 1000.0) as u32),
+            _ => return,
+        };
+        log::debug!("now playing: remote command {command:?}");
+        COMMANDS.lock().unwrap().push_back(command);
+    }
+
+    pub fn init() {
+        unsafe { cb_register_remote_commands(on_command) };
+    }
+
+    /// When another device takes over there is nothing of ours to show or control any more.
+    pub fn set_active(active: bool) {
+        if !active && enabled() {
+            *PLAYING.lock().unwrap() = false;
+            unsafe { cb_now_playing_clear() };
+        }
+    }
+
+    pub fn take_commands() -> Vec<RemoteCommand> {
+        COMMANDS.lock().unwrap().drain(..).collect()
+    }
+
+    fn c(s: &str) -> CString {
+        CString::new(s.replace('\0', "")).unwrap_or_default()
+    }
+
+    fn event_name(event: &PlayerEvent) -> &'static str {
+        match event {
+            PlayerEvent::TrackChanged { .. } => "TrackChanged",
+            PlayerEvent::Playing { .. } => "Playing",
+            PlayerEvent::Paused { .. } => "Paused",
+            PlayerEvent::Stopped { .. } => "Stopped",
+            PlayerEvent::EndOfTrack { .. } => "EndOfTrack",
+            PlayerEvent::Seeked { .. } => "Seeked",
+            PlayerEvent::Loading { .. } => "Loading",
+            _ => "other",
+        }
+    }
+
+    fn set_state(state: i32, position_ms: u32) {
+        *PLAYING.lock().unwrap() = state == 1;
+        unsafe { cb_now_playing_set_state(state, position_ms as f64 / 1000.0) };
+    }
+
+    pub fn handle_event(event: &PlayerEvent) {
+        match event {
+            PlayerEvent::TrackChanged { .. }
+            | PlayerEvent::Playing { .. }
+            | PlayerEvent::Paused { .. }
+            | PlayerEvent::Stopped { .. }
+            | PlayerEvent::EndOfTrack { .. }
+            | PlayerEvent::Seeked { .. }
+            | PlayerEvent::Loading { .. } => {
+                log::debug!("now playing: event {}", event_name(event));
+            }
+            _ => {}
+        }
+        match event {
+            PlayerEvent::TrackChanged { audio_item } => {
+                let (artist, album) = match &audio_item.unique_fields {
+                    UniqueFields::Track { artists, album, .. } => (
+                        artists.0.iter().map(|a| a.name.as_str()).collect::<Vec<_>>().join(", "),
+                        album.clone(),
+                    ),
+                    UniqueFields::Local { artists, album, .. } => {
+                        (artists.clone().unwrap_or_default(), album.clone().unwrap_or_default())
+                    }
+                    UniqueFields::Episode { show_name, .. } => (show_name.clone(), String::new()),
+                };
+                let cover = audio_item
+                    .covers
+                    .iter()
+                    .max_by_key(|cover| cover.width)
+                    .map(|cover| cover.url.as_str())
+                    .unwrap_or("");
+                log::debug!("now playing: {} / {artist} / {album}", audio_item.name);
+                unsafe {
+                    cb_now_playing_set_track(
+                        c(&audio_item.name).as_ptr(),
+                        c(&artist).as_ptr(),
+                        c(&album).as_ptr(),
+                        audio_item.duration_ms as f64 / 1000.0,
+                        c(cover).as_ptr(),
+                    )
+                };
+            }
+            PlayerEvent::Playing { position_ms, .. } => set_state(1, *position_ms),
+            PlayerEvent::Paused { position_ms, .. } => set_state(0, *position_ms),
+            PlayerEvent::Seeked { position_ms, .. }
+            | PlayerEvent::PositionCorrection { position_ms, .. } => {
+                let playing = *PLAYING.lock().unwrap();
+                set_state(if playing { 1 } else { 0 }, *position_ms);
+            }
+            PlayerEvent::Stopped { .. } | PlayerEvent::EndOfTrack { .. } => set_state(2, 0),
+            _ => {}
+        }
+    }
+}
+
+#[cfg(not(target_os = "ios"))]
+mod imp {
+    use super::*;
+    pub fn enabled() -> bool {
+        false
+    }
+    pub fn init() {}
+    pub fn set_active(_active: bool) {}
+    pub fn take_commands() -> Vec<RemoteCommand> {
+        Vec::new()
+    }
+    pub fn handle_event(_event: &PlayerEvent) {}
+}
+
+pub use imp::{enabled, handle_event, init, set_active, take_commands};
diff --git a/src/route_guard.rs b/src/route_guard.rs
new file mode 100644
index 0000000..27fa0ad
--- /dev/null
+++ b/src/route_guard.rs
@@ -0,0 +1,173 @@
+//! connectbridge: keeps the audio from coming out of the iPhone speaker.
+//!
+//! AirPlay connections drop now and then; the system then moves the output to the built-in
+//! speaker. While this device is the active Connect device and the output is required to be the
+//! AirPlay device (`CB_REQUIRE_AIRPLAY`), the audio is silenced the moment the route changes to the
+//! built-in speaker, playback is paused, and it resumes once the route is back (within
+//! `CB_GUARD_RESUME_SECS`, default 30). `connectbridged` selects the AirPlay device again.
+
+#[cfg(target_os = "ios")]
+mod imp {
+    use librespot::{
+        connect::Spirc,
+        playback::{mixer::softmixer::GUARD_MUTE, player::PlayerEvent},
+    };
+    use crate::guard_logic::GuardPause;
+    use std::{
+        os::raw::c_int,
+        sync::{
+            Mutex,
+            atomic::{AtomicBool, Ordering},
+        },
+        time::{Duration, Instant},
+    };
+
+    unsafe extern "C" {
+        fn cb_output_leaks() -> c_int;
+        fn cb_watch_route(callback: extern "C" fn(c_int));
+    }
+
+    static ACTIVE: AtomicBool = AtomicBool::new(false);
+    static LEAKING: AtomicBool = AtomicBool::new(false);
+    static PLAYING: AtomicBool = AtomicBool::new(false);
+    static PAUSED_BY_GUARD: Mutex<GuardPause> = Mutex::new(GuardPause::new());
+
+    pub fn enabled() -> bool {
+        std::env::var_os("CB_REQUIRE_AIRPLAY").is_some()
+    }
+
+    fn resume_window() -> Duration {
+        let secs = std::env::var("CB_GUARD_RESUME_SECS")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(30);
+        Duration::from_secs(secs)
+    }
+
+    fn muted() -> bool {
+        enabled() && ACTIVE.load(Ordering::Relaxed) && LEAKING.load(Ordering::Relaxed)
+    }
+
+    fn apply_mute() {
+        GUARD_MUTE.store(muted(), Ordering::Relaxed);
+    }
+
+    // Called by the system on every route change, on whatever thread: mute at once.
+    extern "C" fn on_route_change(leaking: c_int) {
+        LEAKING.store(leaking != 0, Ordering::Relaxed);
+        apply_mute();
+    }
+
+    pub fn init() {
+        unsafe {
+            cb_watch_route(on_route_change);
+            LEAKING.store(cb_output_leaks() != 0, Ordering::Relaxed);
+        }
+    }
+
+    /// Is the audio output (right now) the built-in speaker / receiver?
+    pub fn output_leaks() -> bool {
+        unsafe { cb_output_leaks() != 0 }
+    }
+
+    pub fn set_active(active: bool) {
+        ACTIVE.store(active, Ordering::Relaxed);
+        if !active {
+            PAUSED_BY_GUARD.lock().unwrap().clear();
+            PLAYING.store(false, Ordering::Relaxed);
+        }
+        LEAKING.store(unsafe { cb_output_leaks() } != 0, Ordering::Relaxed);
+        apply_mute();
+    }
+
+    fn remote_pauses() -> u64 {
+        librespot::connect::REMOTE_PAUSES.load(Ordering::Relaxed)
+    }
+
+    /// A person paused or stopped playback here (a Now Playing command).
+    pub fn user_paused() {
+        // Not playing any more, even before the player's Paused event arrives: otherwise the next
+        // tick sees "playing, output lost" and makes a new record by pausing again.
+        PLAYING.store(false, Ordering::Relaxed);
+        PAUSED_BY_GUARD.lock().unwrap().user_paused();
+    }
+
+    /// Is playback running (as far as the player events say)?
+    pub fn is_playing() -> bool {
+        PLAYING.load(Ordering::Relaxed)
+    }
+
+    pub fn handle_event(event: &PlayerEvent) {
+        match event {
+            PlayerEvent::Playing { .. } => {
+                PLAYING.store(true, Ordering::Relaxed);
+                // Somebody (the user) started playback by hand: not ours to resume any more.
+                // While the output is still muted this is not a decision about the resume (the
+                // output is silent anyway), so the record stays.
+                PAUSED_BY_GUARD.lock().unwrap().on_playing(muted());
+            }
+            PlayerEvent::Paused { .. } | PlayerEvent::Stopped { .. } => {
+                PLAYING.store(false, Ordering::Relaxed);
+                // The first one answers the guard's own pause; a later one is the user's.
+                PAUSED_BY_GUARD.lock().unwrap().on_paused();
+            }
+            _ => {}
+        }
+    }
+
+    pub fn tick(spirc: &Spirc) {
+        if !enabled() {
+            return;
+        }
+        LEAKING.store(unsafe { cb_output_leaks() } != 0, Ordering::Relaxed);
+        apply_mute();
+
+        let mut paused = PAUSED_BY_GUARD.lock().unwrap();
+        let had_record = paused.is_set();
+        paused.check_remote(remote_pauses());
+        if had_record && !paused.is_set() {
+            PLAYING.store(false, Ordering::Relaxed);  // another device paused: same as above
+        }
+        if muted() {
+            if !paused.is_set() && PLAYING.load(Ordering::Relaxed) {
+                log::warn!("route guard: the output left the AirPlay device, pausing");
+                paused.guard_paused(Instant::now(), remote_pauses());
+                drop(paused);
+                if let Err(e) = spirc.pause() {
+                    log::warn!("route guard: could not pause: {e}");
+                }
+            }
+        } else if let Some(in_time) = paused.take_resume(resume_window(), remote_pauses()) {
+            drop(paused);
+            if in_time {
+                log::warn!("route guard: the AirPlay device is back, resuming");
+                if let Err(e) = spirc.play() {
+                    log::warn!("route guard: could not resume: {e}");
+                }
+            } else {
+                log::warn!("route guard: the AirPlay device came back too late, staying paused");
+            }
+        }
+    }
+}
+
+#[cfg(not(target_os = "ios"))]
+mod imp {
+    use librespot::{connect::Spirc, playback::player::PlayerEvent};
+    pub fn enabled() -> bool {
+        false
+    }
+    pub fn init() {}
+    pub fn output_leaks() -> bool {
+        false
+    }
+    pub fn set_active(_active: bool) {}
+    pub fn user_paused() {}
+    pub fn is_playing() -> bool {
+        false
+    }
+    pub fn handle_event(_event: &PlayerEvent) {}
+    pub fn tick(_spirc: &Spirc) {}
+}
+
+pub use imp::{enabled, handle_event, init, is_playing, output_leaks, set_active, tick, user_paused};
diff --git a/src/session_state.rs b/src/session_state.rs
new file mode 100644
index 0000000..bde1f66
--- /dev/null
+++ b/src/session_state.rs
@@ -0,0 +1,42 @@
+//! connectbridge: tells the supervisor (connectbridged) whether this device is the active Spotify
+//! Connect device, so the output route is only held while somebody has selected it.
+//!
+//! `SessionConnected` is emitted when this device becomes the active device (a transfer or a
+//! direct play), `SessionDisconnected` when playback moves to another device or the session ends.
+//! The state is written to the file named by `CB_STATE_FILE` ("active" or "inactive").
+
+use librespot::playback::player::PlayerEvent;
+use std::{fs, path::PathBuf};
+
+fn path() -> Option<PathBuf> {
+    std::env::var_os("CB_STATE_FILE").map(PathBuf::from)
+}
+
+pub fn enabled() -> bool {
+    path().is_some()
+}
+
+fn write(state: &str) {
+    let Some(path) = path() else { return };
+    let tmp = path.with_extension("tmp");
+    if fs::write(&tmp, state).and_then(|_| fs::rename(&tmp, &path)).is_err() {
+        log::warn!("session state: could not write {}", path.display());
+    }
+}
+
+pub fn init() {
+    write("inactive");
+}
+
+pub fn handle_event(event: &PlayerEvent) {
+    let active = match event {
+        PlayerEvent::SessionConnected { .. } => true,
+        PlayerEvent::SessionDisconnected { .. } => false,
+        _ => return,
+    };
+    log::debug!("session state: {}", if active { "active" } else { "inactive" });
+    crate::volume_bridge::set_active(active);
+    crate::now_playing::set_active(active);
+    crate::route_guard::set_active(active);
+    write(if active { "active" } else { "inactive" });
+}
diff --git a/src/volume_bridge.rs b/src/volume_bridge.rs
new file mode 100644
index 0000000..2aacbf9
--- /dev/null
+++ b/src/volume_bridge.rs
@@ -0,0 +1,277 @@
+//! connectbridge: keeps the Spotify Connect volume and the output route (HomePod) volume in sync.
+//!
+//! Connect -> route: every `VolumeChanged` player event is applied to the system volume.
+//! Route -> Connect: the system volume is polled (with CB_VOLUME_NOTIFY: when the KVO says so, plus a slow safety poll); a change that we did not cause (outside the
+//! settle window and beyond the tolerance of the last value we applied) is sent to Spirc.
+//!
+//! Every time this device becomes the active Connect device the volume of the output route wins:
+//! once the wanted AirPlay device really is the system output, its volume is sent to Connect once,
+//! even when it did not change. Whenever it is not (the route is lost, or being switched), nothing
+//! is read from or written to the system volume until it is again and has been for a moment; then
+//! the volume is synced again. The rules are in `volume_logic.rs`, which has no platform calls.
+//!
+//! "The wanted device is the output" is told by connectbridged through the file named by
+//! `CB_ROUTE_FILE` ("ready" / "pending" / "none"; it is the one that selects the device and can
+//! see the output). It is read every time: a missing or unreadable file counts as not ready.
+//! Without that variable (route not managed) the activation grace is used.
+
+#[cfg(target_os = "ios")]
+mod imp {
+    use crate::{
+        notif_check::{NotifCheck, Verdict},
+        volume_logic::VolumeLogic,
+    };
+    use std::{
+        sync::{
+            Mutex, OnceLock,
+            atomic::{AtomicBool, Ordering},
+        },
+        time::{Duration, Instant},
+    };
+
+    unsafe extern "C" {
+        fn cb_get_system_volume() -> f32;
+        fn cb_set_system_volume(v: f32);
+        fn cb_watch_volume_notifications(callback: extern "C" fn(f32));
+    }
+
+    // CB_VOLUME_NOTIF_CHECK: compare the polling with the outputVolume KVO (observation
+    // only, see notif_check.rs). Its own lock: the notification arrives on another thread.
+    static CHECK: Mutex<NotifCheck> = Mutex::new(NotifCheck::new());
+    /// (time, counters) of the last summary line: it is written when the counters changed, at most this often.
+    static LAST_SUMMARY: Mutex<(u64, [u64; 4])> = Mutex::new((0, [0; 4]));
+    const SUMMARY_EVERY_MS: u64 = 30 * 1000;
+
+    /// CB_VOLUME_NOTIFY: no polling of the route volume. It is read when the system says it changed (KVO of outputVolume)
+    /// (`NOTIFIED`) or when `VolumeLogic::needs_poll` says a look is due. Without the variable the
+    /// volume is polled on every tick, as before.
+    static NOTIFIED: AtomicBool = AtomicBool::new(false);
+
+    fn notify_mode() -> bool {
+        static ON: OnceLock<bool> = OnceLock::new();
+        *ON.get_or_init(|| std::env::var_os("CB_VOLUME_NOTIFY").is_some())
+    }
+
+    fn check_enabled() -> bool {
+        static ON: OnceLock<bool> = OnceLock::new();
+        *ON.get_or_init(|| std::env::var_os("CB_VOLUME_NOTIF_CHECK").is_some())
+    }
+
+    /// Starts listening once, if either mode needs the notification.
+    fn start_notifications() {
+        static STARTED: OnceLock<()> = OnceLock::new();
+        STARTED.get_or_init(|| {
+            if notify_mode() || check_enabled() {
+                unsafe { cb_watch_volume_notifications(on_volume_notification) };
+            }
+        });
+    }
+
+    /// KVO of AVAudioSession.outputVolume: the route volume changed (it may fire more than once for one change).
+    extern "C" fn on_volume_notification(_volume: f32) {
+        NOTIFIED.store(true, Ordering::Release);
+        if check_enabled() {
+            CHECK.lock().unwrap().on_notification(now_ms());
+        }
+    }
+
+    /// The check starts this long after the route became ready: the system volume (and its
+    /// notification) follows the output with a delay.
+    const CHECK_SETTLE_MS: u64 = 2_000;
+    static CHECK_READY_SINCE: Mutex<Option<u64>> = Mutex::new(None);
+
+    /// Called on every poll tick; `ready`: the wanted device is the output.
+    fn check_sample(ready: bool) {
+        start_notifications();
+        if !check_enabled() {
+            return;
+        }
+        let now = now_ms();
+        let since = {
+            let mut s = CHECK_READY_SINCE.lock().unwrap();
+            if !ready {
+                *s = None;
+            } else if s.is_none() {
+                *s = Some(now);
+            }
+            *s
+        };
+        if since.is_none_or(|t| now < t + CHECK_SETTLE_MS) {
+            CHECK.lock().unwrap().pause();
+            return;
+        }
+        let raw = unsafe { cb_get_system_volume() };
+        let mut check = CHECK.lock().unwrap();
+        check.on_sample(now, Some(raw));
+        for verdict in check.tick(now) {
+            match verdict {
+                Verdict::Missed(at) => log::warn!("volume check: MISSED a change seen by the polling at {at} ms, no notification came"),
+                Verdict::Extra(at) => log::warn!("volume check: EXTRA notification at {at} ms, the polling saw no change"),
+            }
+        }
+        let counters = [check.changes_seen, check.notifs_seen, check.missed, check.extra];
+        let mut last = LAST_SUMMARY.lock().unwrap();
+        if counters != last.1 && now >= last.0 + SUMMARY_EVERY_MS {
+            *last = (now, counters);
+            log::info!(
+                "volume check: changes={} notifications={} missed={} extra={}",
+                counters[0], counters[1], counters[2], counters[3]
+            );
+        }
+    }
+
+    /// "ready" must have held this long: the system volume follows the output with a delay.
+    const READY_SETTLE_MS: u64 = 1500;
+    /// Without a route file: after this device became active the output route may still be switched.
+    const ACTIVATION_GRACE: Duration = Duration::from_secs(3);
+
+    struct Bridge {
+        logic: VolumeLogic,
+        active_since: Option<Instant>,
+        /// Ticket of the send that `poll_external` returned last, for `sent`.
+        ticket: Option<u64>,
+        /// When the route volume was last looked at (notify mode: for the safety poll).
+        last_look_ms: u64,
+    }
+
+    /// Notify mode: a ready and synced route is looked at this often even when no notification came,
+    /// in case the KVO stops delivering (nothing would tell us). Rare enough to cost nothing.
+    const SAFETY_POLL_MS: u64 = 5_000;
+
+    static BRIDGE: Mutex<Option<Bridge>> = Mutex::new(None);
+
+    fn managed() -> bool {
+        std::env::var_os("CB_ROUTE_FILE").is_some()
+    }
+
+    fn now_ms() -> u64 {
+        static START: OnceLock<Instant> = OnceLock::new();
+        START.get_or_init(Instant::now).elapsed().as_millis() as u64
+    }
+
+    fn with_bridge<R>(f: impl FnOnce(&mut Bridge) -> R) -> R {
+        let mut guard = BRIDGE.lock().unwrap();
+        let bridge = guard.get_or_insert_with(|| Bridge {
+            logic: VolumeLogic::new(if managed() { READY_SETTLE_MS } else { 0 }),
+            active_since: None,
+            ticket: None,
+            last_look_ms: 0,
+        });
+        f(bridge)
+    }
+
+    /// The route file is replaced by rename, so its identity (inode, size, mtime) changes with every
+    /// new content: only read it again when that has changed (this runs every 250 ms).
+    fn route_file_ready(path: &std::ffi::OsStr) -> bool {
+        use std::os::unix::fs::MetadataExt;
+        static CACHE: std::sync::Mutex<Option<((u64, u64, i64, i64), bool)>> = std::sync::Mutex::new(None);
+        let Ok(meta) = std::fs::metadata(path) else {
+            *CACHE.lock().unwrap() = None;
+            return false;
+        };
+        let identity = (meta.ino(), meta.len(), meta.mtime(), meta.mtime_nsec());
+        let mut cache = CACHE.lock().unwrap();
+        if let Some((cached, ready)) = *cache {
+            if cached == identity {
+                return ready;
+            }
+        }
+        let ready = std::fs::read_to_string(path).is_ok_and(|s| s.trim() == "ready");
+        *cache = Some((identity, ready));
+        ready
+    }
+
+    /// Is the wanted AirPlay device the system output right now?
+    fn route_ready(bridge: &Bridge) -> bool {
+        // With the AirPlay device required, a built-in output means that the route is gone (or not
+        // there yet). The system tells at once; connectbridged's file may be a moment behind.
+        if crate::route_guard::enabled() && crate::route_guard::output_leaks() {
+            return false;
+        }
+        match std::env::var_os("CB_ROUTE_FILE") {
+            // The route is not managed by connectbridged: nothing says when it has switched.
+            None => bridge.active_since.is_some_and(|since| since.elapsed() >= ACTIVATION_GRACE),
+            Some(path) => route_file_ready(&path),
+        }
+    }
+
+    /// The bridge only runs while this device is the active Connect device.
+    pub fn set_active(active: bool) {
+        with_bridge(|b| {
+            b.logic.set_active(active);
+            b.active_since = if active { Some(Instant::now()) } else { None };
+            b.ticket = None;
+        });
+    }
+
+    pub fn enabled() -> bool {
+        std::env::var_os("CB_VOLUME_BRIDGE").is_some()
+    }
+
+    /// Connect -> route.
+    pub fn apply_connect_volume(volume: u16) {
+        with_bridge(|b| {
+            let ready = route_ready(b);
+            match b.logic.connect_volume(volume, now_ms(), ready) {
+                Some(v) => {
+                    unsafe { cb_set_system_volume(v) };
+                    log::debug!("volume bridge: connect {volume} -> route {v:.3}");
+                }
+                None => log::debug!("volume bridge: ignoring connect {volume} until the route volume is synced"),
+            }
+        });
+    }
+
+    /// Route -> Connect. Returns the volume to send to Spirc; tell `sent` how it went.
+    pub fn poll_external() -> Option<u16> {
+        with_bridge(|b| {
+            let ready = route_ready(b);
+            check_sample(ready);
+            let now = now_ms();
+            // A notification is only taken when the route is ready: the volume of another route
+            // (the built-in speaker) means nothing, and the logic forgets everything meanwhile.
+            let notified = ready && NOTIFIED.swap(false, Ordering::AcqRel);
+            if !ready {
+                NOTIFIED.store(false, Ordering::Release);
+            }
+            // Without polling, a ready and synced route is only looked at when something says so.
+            if notify_mode()
+                && ready
+                && !notified
+                && !b.logic.needs_poll(now)
+                && now < b.last_look_ms + SAFETY_POLL_MS
+            {
+                return None;
+            }
+            b.last_look_ms = now;
+            let (volume, ticket) = b.logic.poll(now, ready, true, || unsafe { cb_get_system_volume() })?;
+            b.ticket = Some(ticket);
+            log::debug!("volume bridge: route -> connect {volume}");
+            Some(volume)
+        })
+    }
+
+    /// Spirc's answer for the volume that `poll_external` returned.
+    pub fn sent(ok: bool) {
+        with_bridge(|b| {
+            if let Some(ticket) = b.ticket.take() {
+                b.logic.sent(ticket, ok, now_ms());
+            }
+        });
+    }
+}
+
+#[cfg(not(target_os = "ios"))]
+mod imp {
+    pub fn enabled() -> bool {
+        false
+    }
+    pub fn set_active(_active: bool) {}
+    pub fn apply_connect_volume(_volume: u16) {}
+    pub fn poll_external() -> Option<u16> {
+        None
+    }
+    pub fn sent(_ok: bool) {}
+}
