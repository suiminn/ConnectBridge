diff --git a/src/guard_logic.rs b/src/guard_logic.rs
new file mode 100644
index 0000000..2be0ef7
--- /dev/null
+++ b/src/guard_logic.rs
@@ -0,0 +1,188 @@
+//! connectbridge: the "paused by the route guard" record, without any platform calls, so that it
+//! can be tested on a Mac (`scripts/test-daemon.sh` runs the tests below with `rustc --test`).
+//!
+//! The guard pauses playback when the AirPlay device is lost and resumes it when the device is
+//! back, unless somebody decided otherwise meanwhile. Who paused cannot be read from a
+//! `PlayerEvent`, so the people's pauses are reported where they come in:
+//! - `user_paused`: a local command (Now Playing pause, or play/pause while playing);
+//! - the remote pause counter (`librespot_connect::REMOTE_PAUSES`): another Spotify device paused.
+//!   The guard's own pause does not go through there.
+//! Either one, before or after the guard's pause was answered, cancels the resume.
+//!
+//! What cannot be identified: a pause that the player itself causes (end of the queue, an error).
+//! The first Paused event after the guard's pause is taken as the answer to it and keeps the
+//! record; a further one cancels it (the safe side: nothing starts playing on its own). A Playing
+//! event while the output is not muted is the user's too (while muted it is not a decision).
+
+#![allow(dead_code)]
+
+use std::time::{Duration, Instant};
+
+#[derive(Default)]
+pub struct GuardPause {
+    since: Option<Instant>,
+    answered: bool,
+    remote_pauses: u64,
+}
+
+impl GuardPause {
+    pub const fn new() -> Self {
+        GuardPause { since: None, answered: false, remote_pauses: 0 }
+    }
+
+    pub fn is_set(&self) -> bool {
+        self.since.is_some()
+    }
+
+    /// The guard is pausing playback now; `remote_pauses` is the counter at this moment.
+    pub fn guard_paused(&mut self, now: Instant, remote_pauses: u64) {
+        self.since = Some(now);
+        self.answered = false;
+        self.remote_pauses = remote_pauses;
+    }
+
+    /// A Paused / Stopped event from the player.
+    pub fn on_paused(&mut self) {
+        if self.since.is_none() {
+            return;
+        }
+        if self.answered {
+            self.since = None;
+        } else {
+            self.answered = true;
+        }
+    }
+
+    /// A Playing event from the player.
+    pub fn on_playing(&mut self, muted: bool) {
+        if !muted {
+            self.since = None;
+        }
+    }
+
+    /// A person paused or stopped here (local command).
+    pub fn user_paused(&mut self) {
+        self.since = None;
+    }
+
+    /// Another Spotify device paused since the guard did: the counter went up.
+    pub fn check_remote(&mut self, remote_pauses: u64) {
+        if self.since.is_some() && remote_pauses != self.remote_pauses {
+            self.since = None;
+        }
+    }
+
+    pub fn clear(&mut self) {
+        self.since = None;
+    }
+
+    /// The AirPlay device is back: should playback resume? Takes the record either way.
+    pub fn take_resume(&mut self, window: Duration, remote_pauses: u64) -> Option<bool> {
+        self.check_remote(remote_pauses);
+        self.since.take().map(|since| since.elapsed() <= window)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const WINDOW: Duration = Duration::from_secs(30);
+
+    fn paused_by_guard() -> GuardPause {
+        let mut g = GuardPause::default();
+        g.guard_paused(Instant::now(), 7);
+        g
+    }
+
+    #[test]
+    fn guard_pause_answered_then_back_resumes() {
+        let mut g = paused_by_guard();
+        g.on_paused(); // the guard's own pause arriving
+        assert!(g.is_set(), "the answer alone does not drop the record");
+        assert_eq!(g.take_resume(WINDOW, 7), Some(true));
+        assert_eq!(g.take_resume(WINDOW, 7), None);
+    }
+
+    #[test]
+    fn local_user_pause_before_the_answer_cancels() {
+        let mut g = paused_by_guard();
+        g.user_paused(); // before the guard's pause event arrives
+        g.on_paused(); // the guard's answer arrives afterwards
+        assert_eq!(g.take_resume(WINDOW, 7), None);
+    }
+
+    #[test]
+    fn remote_user_pause_before_the_answer_cancels() {
+        let mut g = paused_by_guard();
+        g.on_paused();
+        assert_eq!(g.take_resume(WINDOW, 8), None, "another device paused");
+        let mut g = paused_by_guard();
+        g.check_remote(8); // seen by the tick before the answer
+        g.on_paused();
+        assert_eq!(g.take_resume(WINDOW, 8), None);
+    }
+
+    #[test]
+    fn user_pause_after_the_answer_cancels() {
+        let mut g = paused_by_guard();
+        g.on_paused();
+        g.user_paused();
+        assert_eq!(g.take_resume(WINDOW, 7), None);
+        // A second Paused event that nothing explains also cancels (the safe side).
+        let mut g = paused_by_guard();
+        g.on_paused();
+        g.on_paused();
+        assert_eq!(g.take_resume(WINDOW, 7), None);
+    }
+
+    #[test]
+    fn user_play_then_pause_while_lost_cancels() {
+        let mut g = paused_by_guard();
+        g.on_paused();
+        g.on_playing(true); // play while muted: not a decision
+        assert!(g.is_set());
+        g.user_paused();
+        assert_eq!(g.take_resume(WINDOW, 7), None);
+    }
+
+    #[test]
+    fn play_after_the_device_is_back_cancels() {
+        let mut g = paused_by_guard();
+        g.on_paused();
+        g.on_playing(false);
+        assert_eq!(g.take_resume(WINDOW, 7), None);
+    }
+
+    #[test]
+    fn too_late_does_not_resume() {
+        let mut g = GuardPause::default();
+        g.guard_paused(Instant::now() - Duration::from_secs(31), 7);
+        assert_eq!(g.take_resume(WINDOW, 7), Some(false));
+    }
+
+    #[test]
+    fn events_without_a_record_do_nothing() {
+        let mut g = GuardPause::default();
+        g.on_paused();
+        g.on_playing(true);
+        g.user_paused();
+        g.check_remote(99);
+        assert!(!g.is_set());
+        assert_eq!(g.take_resume(WINDOW, 0), None);
+        // and a record made afterwards is not affected by what came before
+        g.guard_paused(Instant::now(), 99);
+        g.on_paused();
+        assert_eq!(g.take_resume(WINDOW, 99), Some(true));
+    }
+
+    #[test]
+    fn a_new_guard_pause_starts_over() {
+        let mut g = paused_by_guard();
+        g.on_paused();
+        g.on_paused(); // cancelled
+        g.guard_paused(Instant::now(), 7); // lost again later
+        g.on_paused();
+        assert!(g.is_set());
+    }
+}
diff --git a/src/ios_audio_session.m b/src/ios_audio_session.m
new file mode 100644
index 0000000..64a136d
--- /dev/null
+++ b/src/ios_audio_session.m
@@ -0,0 +1,219 @@
+#import <AVFoundation/AVFoundation.h>
+#include <dlfcn.h>
+
+// connectbridge: cpal does not configure the AVAudioSession, so a bare CLI process stays silent.
+void cb_activate_audio_session(void) {
+    NSError *err = nil;
+    AVAudioSession *s = [AVAudioSession sharedInstance];
+    if (![s setCategory:AVAudioSessionCategoryPlayback error:&err]) {
+        NSLog(@"librespot: setCategory failed: %@", err);
+        return;
+    }
+    if (![s setActive:YES error:&err]) {
+        NSLog(@"librespot: setActive failed: %@", err);
+        return;
+    }
+    NSLog(@"librespot: audio session active, route=%@", [s.currentRoute.outputs valueForKey:@"portName"]);
+
+    // Another app (Siri starting Apple Music, a call, ...) can interrupt the session. cpal does not
+    // restart its stream afterwards, so the player would block forever and Spotify Connect would
+    // hang on "Connecting". The simplest reliable recovery is to exit and let connectbridged
+    // start a fresh process once the interruption is over.
+    [[NSNotificationCenter defaultCenter] addObserverForName:AVAudioSessionInterruptionNotification object:nil queue:nil
+        usingBlock:^(NSNotification *n) {
+            AVAudioSessionInterruptionType type = [n.userInfo[AVAudioSessionInterruptionTypeKey] unsignedIntegerValue];
+            NSLog(@"librespot: audio session interruption %@", type == AVAudioSessionInterruptionTypeBegan ? @"began" : @"ended");
+            if (type == AVAudioSessionInterruptionTypeEnded) {
+                NSLog(@"librespot: restarting after the interruption");
+                _exit(75);  // not exit(): this runs on a notification thread while the runtime is still running
+            }
+        }];
+    [[NSNotificationCenter defaultCenter] addObserverForName:AVAudioSessionMediaServicesWereResetNotification object:nil queue:nil
+        usingBlock:^(NSNotification *n) {
+            NSLog(@"librespot: media services were reset, restarting");
+            _exit(75);
+        }];
+}
+
+// --- system (output route) volume, used by the Connect <-> HomePod volume bridge ---
+@interface AVSystemController : NSObject
++ (instancetype)sharedAVSystemController;
+- (BOOL)getVolume:(float *)v forCategory:(NSString *)c;
+- (BOOL)setVolumeTo:(float)v forCategory:(NSString *)c;
+@end
+
+// Private API: if this iOS does not have it, the volume bridge does nothing instead of crashing.
+static AVSystemController *cb_system_controller(void) {
+    Class cls = NSClassFromString(@"AVSystemController");
+    if (![cls respondsToSelector:@selector(sharedAVSystemController)]) return nil;
+    AVSystemController *sc = [cls sharedAVSystemController];
+    return ([sc respondsToSelector:@selector(getVolume:forCategory:)] && [sc respondsToSelector:@selector(setVolumeTo:forCategory:)]) ? sc : nil;
+}
+
+float cb_get_system_volume(void) {
+    AVSystemController *sc = cb_system_controller();
+    // Not the *active* category: it flips (e.g. to FindMyPhone) and reports unrelated volumes.
+    float v = -1;
+    if (!sc || ![sc getVolume:&v forCategory:@"Audio/Video"]) return -1;
+    return v;
+}
+
+void cb_set_system_volume(float v) {
+    AVSystemController *sc = cb_system_controller();
+    [sc setVolumeTo:v forCategory:@"Audio/Video"];
+}
+
+// "The route volume changed": the KVO of AVAudioSession.outputVolume (public API; it works on iOS 15.8
+// and on iPadOS 18.7, where MediaRemote's volume notification does not come). It can fire more than
+// once for one change. `fn` gets the new volume.
+typedef void (*cb_volume_fn)(float);
+
+@interface CBVolumeObserver : NSObject
+@property(nonatomic) cb_volume_fn fn;
+@end
+@implementation CBVolumeObserver
+- (void)observeValueForKeyPath:(NSString *)keyPath ofObject:(id)object change:(NSDictionary *)change context:(void *)context {
+    self.fn([change[NSKeyValueChangeNewKey] floatValue]);
+}
+@end
+
+void cb_watch_volume_notifications(cb_volume_fn fn) {
+    static CBVolumeObserver *observer;  // KVO does not retain its observer
+    observer = [CBVolumeObserver new];
+    observer.fn = fn;
+    [[AVAudioSession sharedInstance] addObserver:observer forKeyPath:@"outputVolume" options:NSKeyValueObservingOptionNew context:NULL];
