+        assert_eq!(poll(&mut l, 0, true, 0.2, &reads), None);
+        assert!(poll(&mut l, SETTLE, true, 0.2, &reads).is_some());
+    }
+
+    #[test]
+    fn route_lost_unsyncs_at_once() {
