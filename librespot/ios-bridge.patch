+//! connectbridge: the state machine of the volume sync between Spotify Connect and the output
+//! route, without any platform calls, so that it can be tested on a Mac
+//! (`scripts/test-daemon.sh` runs the tests below with `rustc --test`).
+//!
+//! Rules:
+//! - Nothing is read from or written to the route unless the route is the wanted AirPlay device
+//!   (`ready`). The moment it is not (lost, being switched, status unreadable) everything is
+//!   forgotten: synced or not, what was applied, what was being sent.
+//! - Back to `ready`, the route must stay `ready` for `settle_ms` before the first sync, which
+//!   sends the route volume to Connect once, whether it changed or not.
+//! - A send counts only when Spirc accepted it (`sent`); otherwise it is tried again later.
+//!   A result for a send from before the route was lost is ignored (ticket / generation).
+//! - After the first sync, a change of the route volume that we did not cause is sent to Connect,
+//!   and a Connect volume is applied to the route.
+//!
+//! Times are milliseconds on any monotonic clock.
+
+#![allow(dead_code)]
+
+/// Volumes closer than this are considered equal (HomePod quantizes its steps).
+pub const TOLERANCE: f32 = 0.015;
+/// After we apply a Connect volume the route needs a moment to report it back.
+pub const SETTLE_MS: u64 = 1500;
+/// Wait before the initial send is tried again.
+pub const RETRY_MS: u64 = 1000;
+
+struct Sending {
+    initial: bool,
+    volume: f32,
+    /// `applied` before an external-change send (restored when it fails).
+    previous: f32,
+    ticket: u64,
+}
+
+pub struct VolumeLogic {
+    /// How long the route must have been ready before the first sync.
+    ready_settle_ms: u64,
+    active: bool,
+    synced: bool,
+    ready_since: Option<u64>,
+    retry_at: Option<u64>,
+    sending: Option<Sending>,
+    /// The route volume as of the last sync / apply, and when.
+    applied: Option<(f32, u64)>,
+    generation: u64,
+    /// Without polling (`needs_poll`): when the route volume has to be looked at again although no
+    /// notification came: the end of the settle window after we applied / sent a volume (a change
+    /// during the window was ignored), or at once after a failed send.
+    due_at: Option<u64>,
+}
+
+fn to_u16(volume: f32) -> u16 {
+    (volume.clamp(0.0, 1.0) * u16::MAX as f32).round() as u16
+}
+
+impl VolumeLogic {
+    pub fn new(ready_settle_ms: u64) -> Self {
+        VolumeLogic {
+            ready_settle_ms,
+            active: false,
+            synced: false,
+            ready_since: None,
+            retry_at: None,
+            sending: None,
+            applied: None,
+            generation: 0,
+            due_at: None,
+        }
+    }
+
+    fn mark_due(&mut self, t: u64) {
+        self.due_at = Some(self.due_at.map_or(t, |d| d.min(t)));
+    }
+
+    /// For a caller that does not poll every tick but waits for the system's volume notification:
+    /// must `poll` be called now although no notification came? True until the first sync is done
+    /// (it only waits for time and for Spirc), and when a look at the route volume was put off
+    /// (settle window, failed send, a send that was in progress).
+    pub fn needs_poll(&self, now: u64) -> bool {
+        self.active && (!self.synced || self.due_at.is_some_and(|t| now >= t))
+    }
+
+    fn forget(&mut self) {
+        self.synced = false;
+        self.ready_since = None;
+        self.retry_at = None;
+        self.sending = None;
+        self.applied = None;
+        self.due_at = None;
+        self.generation += 1; // results of sends from before are stale now
+    }
+
+    /// This device became (or stopped being) the active Connect device.
+    pub fn set_active(&mut self, active: bool) {
+        self.active = active;
+        self.forget();
+    }
+
+    pub fn is_synced(&self) -> bool {
+        self.synced
+    }
+
+    /// Takes the route status. Returns whether the route is ready; if it is not, everything is
+    /// forgotten at once.
+    fn route(&mut self, ready: bool, now: u64) -> bool {
+        if !ready {
+            if self.synced || self.ready_since.is_some() || self.sending.is_some() || self.applied.is_some() || self.retry_at.is_some() {
+                self.forget();
+            }
+            return false;
+        }
+        self.ready_since.get_or_insert(now);
+        true
+    }
+
+    /// Connect -> route. Returns the route volume to set, if setting it is allowed now.
+    pub fn connect_volume(&mut self, volume: u16, now: u64, ready: bool) -> Option<f32> {
+        if !self.active || !self.route(ready, now) || !self.synced {
+            return None; // not synced yet: the route volume wins, the Connect one waits
+        }
+        let v = volume as f32 / u16::MAX as f32;
+        self.applied = Some((v, now));
+        self.mark_due(now + SETTLE_MS); // a change of the route volume before that is ignored
+        Some(v)
+    }
+
+    /// Route -> Connect. Returns the volume to send to Spirc, with the ticket to give `sent`.
+    /// `read` reads the route volume (negative: unknown); it is only called when the route is
+    /// ready. `allowed` is a further condition for the first sync (e.g. the output is not the
+    /// built-in speaker).
+    pub fn poll(&mut self, now: u64, ready: bool, allowed: bool, read: impl FnOnce() -> f32) -> Option<(u16, u64)> {
+        if !self.active || !self.route(ready, now) {
+            return None;
+        }
+        if !self.synced {
+            let since = self.ready_since.unwrap_or(now);
+            if self.sending.is_some()
+                || self.retry_at.is_some_and(|t| now < t)
+                || now.saturating_sub(since) < self.ready_settle_ms
+                || !allowed
+            {
+                return None;
+            }
+            let cur = read();
+            if cur < 0.0 {
+                return None;
+            }
+            self.sending = Some(Sending { initial: true, volume: cur, previous: cur, ticket: self.generation });
+            return Some((to_u16(cur), self.generation));
+        }
+        let cur = read();
+        if cur < 0.0 {
+            self.mark_due(now + RETRY_MS); // could not be read: try again, a notification may not come
+            return None;
+        }
+        let (applied, at) = self.applied?;
+        if now.saturating_sub(at) < SETTLE_MS || self.sending.is_some() {
+            return None; // looked at again later: `due_at` / `sent`
+        }
+        if self.due_at.is_some_and(|t| now >= t) {
+            self.due_at = None; // looked at it now
+        }
+        if (cur - applied).abs() < TOLERANCE {
+            return None;
+        }
+        self.sending = Some(Sending { initial: false, volume: cur, previous: applied, ticket: self.generation });
+        self.applied = Some((cur, now));
+        self.mark_due(now + SETTLE_MS);
+        Some((to_u16(cur), self.generation))
+    }
+
+    /// Spirc's answer for the send that `poll` returned with `ticket`.
+    pub fn sent(&mut self, ticket: u64, ok: bool, now: u64) {
+        if ticket != self.generation {
+            return; // the route was lost (and maybe is back) since: not this sync's result
+        }
+        let Some(sending) = self.sending.take() else { return };
+        if sending.ticket != ticket {
+            return;
+        }
+        if sending.initial {
+            if ok {
+                self.synced = true;
+                self.applied = Some((sending.volume, now));
+                self.mark_due(now + SETTLE_MS);
+            } else {
+                self.retry_at = Some(now + RETRY_MS);
+            }
+        } else if !ok {
+            // Back to what it was: the difference is seen again and sent again.
+            self.applied = Some((sending.previous, now.saturating_sub(SETTLE_MS)));
+            self.mark_due(now);
+        } else {
+            self.mark_due(now); // changes while the send was in progress were not looked at
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::cell::Cell;
+
+    const SETTLE: u64 = 1500;
+
+    fn logic() -> VolumeLogic {
+        let mut l = VolumeLogic::new(SETTLE);
+        l.set_active(true);
+        l
+    }
+
+    /// Polls with a route volume and counts the reads.
+    fn poll(l: &mut VolumeLogic, now: u64, ready: bool, volume: f32, reads: &Cell<u32>) -> Option<(u16, u64)> {
+        l.poll(now, ready, true, || {
+            reads.set(reads.get() + 1);
+            volume
+        })
+    }
+
+    #[test]
+    fn pending_then_ready_then_stable_then_synced() {
+        let mut l = logic();
+        let reads = Cell::new(0);
+        assert_eq!(poll(&mut l, 0, false, 0.4, &reads), None); // selecting
+        assert_eq!(poll(&mut l, 250, false, 0.4, &reads), None);
+        assert_eq!(poll(&mut l, 1000, true, 0.4, &reads), None); // ready, but not for long
+        assert_eq!(poll(&mut l, 2400, true, 0.4, &reads), None); // 1400 ms
+        assert_eq!(reads.get(), 0, "the route volume is not read before it is stable");
+        let (volume, ticket) = poll(&mut l, 2500, true, 0.4, &reads).expect("initial sync");
+        assert_eq!(volume, (0.4f32 * u16::MAX as f32).round() as u16);
+        assert!(!l.is_synced(), "not synced before Spirc accepted it");
+        l.sent(ticket, true, 2500);
+        assert!(l.is_synced());
+        // The echo from Connect is within the tolerance: not sent again; the route follows Connect.
+        assert_eq!(poll(&mut l, 5000, true, 0.4, &reads), None);
+        assert!(l.connect_volume((0.4f32 * u16::MAX as f32) as u16, 5100, true).is_some());
+    }
+
